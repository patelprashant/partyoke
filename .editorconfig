root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{kt,kts}]
# ktlint configuration
ktlint_code_style = android_studio
# Compose @Composable functions are PascalCase; silence the function-naming rule.
ktlint_function_naming_ignore_when_annotated_with = Composable
# These rules frequently conflict with existing Android/Compose code; relax them
# so CI focuses on substantive issues rather than churn on the current codebase.
ktlint_standard_no-wildcard-imports = disabled
ktlint_standard_max-line-length = disabled
ktlint_standard_function-signature = disabled
ktlint_standard_filename = disabled

[*.{yml,yaml,json}]
indent_size = 2
